{
  "name": "nova-downloader",
  "version": "1.0.5",
  "description": "A beautiful, fast, and modern YouTube and video downloader powered by yt-dlp",
  "main": "dist/main/main.js",
  "author": "NovaDownloader Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"Vite,Electron\" -c \"cyan.bold,yellow.bold\" \"vite\" \"npm run wait:electron\"",
    "wait:electron": "node scripts/dev-runner.js",
    "build": "npm run build:renderer && npm run build:main && npm run build:server",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:server": "tsc -p tsconfig.server.json",
    "web": "npm run build:renderer && npm run build:server && node dist/server/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
